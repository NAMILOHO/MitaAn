rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviewCount']));
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.titre is string
        && request.resource.data.titre.size() >= 5
        && request.resource.data.titre.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read, write: if isAuth()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth()
          && resource.data.receiverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications_queue/{docId} {
      allow read: if false;
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
